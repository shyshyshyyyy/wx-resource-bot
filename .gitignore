# ============================================================
# 源码纳入版本管理，排除：运行时数据 / 敏感凭据 / 虚拟环境 / 构建产物
# ============================================================

# ---- 运行时数据（含账号 cookie、授权码、机器码锁、令牌缓存，绝不可入库）----
data/
panel_logs/

# ---- 敏感凭据 ----
WXAUTOX_LICENSE
*.lock
.license

# ---- 虚拟环境 ----
.venv/
.venv313/
venv/

# ---- 构建产物 ----
build/
dist/
*.exe
*.spec.bak

# ---- Python 缓存 ----
__pycache__/
*.pyc
*.pyo
*.pyd

# ---- 日志与调试输出 ----
*.log
build_*.log
build_log_*.txt
*_debug.log
debug_*.py
_debug*.py
_t_*.py
_ssh.py

# ---- 第三方参考源码（自带 .git，仅作移植参考，不入本仓库）----
_ref/

# ---- 备份目录 ----
*_bak*/
_old/

# ---- 本地工作区 ----
.workbuddy/
